# MediNexPlus environment template
# Copy this file to .env and replace placeholder values with real credentials.
# Do not commit real secrets or API keys.
# This template is reconstructed from the repository source code only.

# -----------------------------------------------------------------------------
# 1) Application configuration
# -----------------------------------------------------------------------------
# Automatically provided by Next.js in production/development. Usually leave unset.
NODE_ENV=development
NEXT_PHASE=development

# Public base URL used in email links, AI headers, and login redirects.
# Required in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev-only feature unlock flag. Must be false in production.
# Valid values: true|false
DEV_UNLOCK_PLANS=false

# -----------------------------------------------------------------------------
# 2) Database / Prisma
# -----------------------------------------------------------------------------
# Required. MySQL connection string for Prisma.
DATABASE_URL=mysql://root:root123@127.0.0.1:3306/medinex
# -----------------------------------------------------------------------------
# 3) Authentication and JWT
# -----------------------------------------------------------------------------
# Required in production. Use a long random secret string.
JWT_SECRET=replace-with-a-long-random-secret

# Required in production. Use a separate long random secret string.
SESSION_SECRET=replace-with-a-long-random-session-secret

# -----------------------------------------------------------------------------
# 4) Super Admin
# -----------------------------------------------------------------------------
# Required in production.
SUPER_ADMIN_EMAIL=anmol@gmail.com
SUPER_ADMIN_PASSWORD=12345678
SUPER_ADMIN_SECURITY_KEY=dog

# -----------------------------------------------------------------------------
# 5) Email / SMTP
# -----------------------------------------------------------------------------
# Required in production for email sending.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-smtp-user@example.com
EMAIL_PASSWORD=your-smtp-password

# Compatibility aliases used by some modules.
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password

# -----------------------------------------------------------------------------
# 6) SMS / OTP
# -----------------------------------------------------------------------------
# Required in production for SMS OTP delivery.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+12345678901

# -----------------------------------------------------------------------------
# 7) Payment gateways
# -----------------------------------------------------------------------------
# Cashfree is optional unless online payment is enabled.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=TEST_OR_PRODUCTION_APP_ID
CASHFREE_SECRET_KEY=replace-with-cashfree-secret-key

# -----------------------------------------------------------------------------
# 8) AI services
# -----------------------------------------------------------------------------
# Gemini API key for medical AI assistance.
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API key appears in local test scripts, not the active app runtime.
OPENAI_API_KEY=your-openai-api-key

# OpenRouter API key is used for AI fallback and blog generation.
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional OpenRouter metadata used in request headers.
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=Hospital Management System

# -----------------------------------------------------------------------------
# 9) File storage
# -----------------------------------------------------------------------------
# Required in production for Cloudinary uploads.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# -----------------------------------------------------------------------------
# 10) External APIs / site configuration
# -----------------------------------------------------------------------------
# Optional hospital metadata for enquiry and demo email flows.
HOSPITAL_NAME=clickmyQ+
HOSPITAL_EMAIL=contact@example.com
HOSPITAL_PHONE=+91 90000 00000

# Optional Google Apps Script webhook for enquiry capture.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec

# -----------------------------------------------------------------------------
# 11) Notes
# -----------------------------------------------------------------------------
# - Some variables are aliases that support multiple modules, including SMTP and email delivery helpers.
# - Variables automatically set by the framework (NODE_ENV, NEXT_PHASE) are intentionally listed for audit completeness but are usually not specified manually.
# - Replace every placeholder before production deployment.
