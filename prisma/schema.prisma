  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([itemId])
  @@index([hospitalId])
  @@index([batchId], map: "StockTransferItem_batchId_fkey")
}

model StockReturn {
  id             String        @id @default(uuid())
  hospitalId     String
  returnNo       String
  fromLocationId String
  toLocationId   String
  type           String        @default("EXCESS")
  status         String        @default("PENDING")
  notes          String?       @db.Text
  requestedBy    String?
  approvedBy     String?
  returnedAt     DateTime?
  itemId         String
  batchId        String?
  quantity       Int
  reason         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  batch          StockBatch?   @relation(fields: [batchId], references: [id])
  fromLocation   StockLocation @relation("ReturnFrom", fields: [fromLocationId], references: [id], onDelete: Cascade)
  hospital       Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  toLocation     StockLocation @relation("ReturnTo", fields: [toLocationId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, returnNo])
  @@index([hospitalId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@index([batchId], map: "StockReturn_batchId_fkey")
  @@index([itemId], map: "StockReturn_itemId_fkey")
}

model LabTest {
  id              String         @id @default(uuid())
  hospitalId      String
  subDepartmentId String
  name            String
  code            String
  category        String         @default("OTHER")
  specimenType    String         @default("BLOOD")
  price           Float          @default(0)
  unit            String?
  normalRangeMin  Float?
  normalRangeMax  Float?
  normalRangeText String?
  method          String?
  turnaroundHrs   Int            @default(24)
  isActive        Boolean        @default(true)
  machineId       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  orderItems      LabOrderItem[]
  panelItems      LabPanelItem[]
  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  subDepartment   SubDepartment  @relation(fields: [subDepartmentId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([subDepartmentId])
  @@index([hospitalId, category])
}

model LabPanel {
  id              String         @id @default(uuid())
  hospitalId      String
  subDepartmentId String
  name            String
  code            String
  description     String?        @db.Text
  price           Float          @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  orderItems      LabOrderItem[]
  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  subDepartment   SubDepartment  @relation(fields: [subDepartmentId], references: [id], onDelete: Cascade)
  items           LabPanelItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([subDepartmentId])
}

model LabPanelItem {
  id       String   @id @default(uuid())
  panelId  String
  testId   String
  sequence Int      @default(0)
  panel    LabPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  test     LabTest  @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([panelId, testId])
  @@index([panelId])
  @@index([testId])
}

model LabOrder {
  id                 String         @id @default(uuid())
  hospitalId         String
  subDepartmentId    String
  patientId          String
  appointmentId      String?
  doctorId           String?
  orderNo            String
  priority           LabPriority    @default(ROUTINE)
  status             LabOrderStatus @default(PENDING)
  orderType          String         @default("MANUAL")
  clinicalNotes      String?        @db.Text
  referralNotes      String?        @db.Text
  isHomeCollection   Boolean        @default(false)
  collectionAddress  String?        @db.Text
  totalAmount        Float          @default(0)
  interpretation     String?        @db.Text
  impression         String?        @db.Text
  pathologistRemarks String?        @db.Text
  recommendation     String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  appointment        Appointment?   @relation(fields: [appointmentId], references: [id])
  doctor             Doctor?        @relation(fields: [doctorId], references: [id])
  hospital           Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  subDepartment      SubDepartment  @relation(fields: [subDepartmentId], references: [id], onDelete: Cascade)
  items              LabOrderItem[]
  report             LabReport?
  sample             LabSample?

  @@unique([hospitalId, orderNo])
  @@index([hospitalId])
  @@index([subDepartmentId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([hospitalId, status])
  @@index([hospitalId, createdAt])
  @@index([doctorId], map: "LabOrder_doctorId_fkey")
}

model LabOrderItem {
  id          String        @id @default(uuid())
  orderId     String
  testId      String?
  panelId     String?
  status      LabItemStatus @default(PENDING)
  result      String?       @db.Text
  unit        String?
  normalRange String?
  isAbnormal  Boolean       @default(false)
  isCritical  Boolean       @default(false)
  notes       String?       @db.Text
  enteredBy   String?
  enteredAt   DateTime?
  verifiedBy  String?
  verifiedAt  DateTime?
  createdAt   DateTime      @default(now())
  order       LabOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  panel       LabPanel?     @relation(fields: [panelId], references: [id])
  test        LabTest?      @relation(fields: [testId], references: [id])

  @@index([orderId])
  @@index([testId])
  @@index([panelId])
}

model LabSample {
  id              String          @id @default(uuid())
  orderId         String          @unique
  hospitalId      String
  barcodeId       String
  specimenType    String          @default("BLOOD")
  collectedBy     String?
  collectedAt     DateTime        @default(now())
  receivedAt      DateTime?
  receivedBy      String?
  status          LabSampleStatus @default(COLLECTED)
  rejectionReason String?
  notes           String?         @db.Text
  hospital        Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  order           LabOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, barcodeId])
  @@index([hospitalId])
  @@index([hospitalId, status])
}

model LabReport {
  id             String          @id @default(uuid())
  orderId        String          @unique
  hospitalId     String
  reportData     String?         @db.LongText
  verifiedBy     String?
  verifiedAt     DateTime?
  deliveredAt    DateTime?
  deliveryMethod String?
  status         LabReportStatus @default(DRAFT)
  notes          String?         @db.Text
  generatedAt    DateTime        @default(now())
  hospital       Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  order          LabOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([hospitalId, status])
}

model IPDAdmission {
  id                String               @id @default(uuid())
  hospitalId        String
  allocationId      String               @unique
  patientId         String?
  ipdNumber         String
  admissionType     IPDAdmissionType     @default(PLANNED)
  assignedDoctorId  String?
  departmentId      String?
  insuranceProvider String?
  insuranceId       String?
  corporateName     String?
  admissionNotes    String?              @db.Text
  status            IPDAdmissionStatus   @default(ADMITTED)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  allocation        BedAllocation        @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  hospital          Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient           Patient?             @relation(fields: [patientId], references: [id])
  transfers         IPDBedTransfer[]
  clinicalNotes     IPDClinicalNote[]
  dischargeSummary  IPDDischargeSummary?
  medicationOrders  IPDMedicationOrder[]
  vitals            IPDVitals[]

  @@unique([hospitalId, ipdNumber])
  @@index([hospitalId])
  @@index([hospitalId, status])
  @@index([patientId])
}

model IPDVitals {
  id                     String       @id @default(uuid())
  hospitalId             String
  admissionId            String
  recordedAt             DateTime     @default(now())
  recordedBy             String?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  pulse                  Int?
  temperature            Float?
  respiratoryRate        Int?
  oxygenSaturation       Float?
  bloodSugar             Float?
  weight                 Float?
  notes                  String?      @db.Text
  admission              IPDAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  hospital               Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([hospitalId])
}

model IPDClinicalNote {
  id          String              @id @default(uuid())
  hospitalId  String
  admissionId String
  type        IPDClinicalNoteType @default(PROGRESS_NOTE)
  content     String              @db.Text
  authorName  String
  authorRole  String?
  createdAt   DateTime            @default(now())
  admission   IPDAdmission        @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  hospital    Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([hospitalId])
}

model IPDMedicationOrder {
  id              String                        @id @default(uuid())
  hospitalId      String
  admissionId     String
  medicationName  String
  dosage          String
  frequency       String
  route           IPDMedicationRoute            @default(ORAL)
  startDate       DateTime                      @default(now())
  endDate         DateTime?
  status          IPDMedicationStatus           @default(ACTIVE)
  prescribedBy    String?
  notes           String?                       @db.Text
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  administrations IPDMedicationAdministration[]
  admission       IPDAdmission                  @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  hospital        Hospital                      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([hospitalId])
}

model IPDMedicationAdministration {
  id             String             @id @default(uuid())
  hospitalId     String
  orderId        String
  scheduledTime  DateTime
  administeredAt DateTime?
  administeredBy String?
  status         IPDMARStatus       @default(GIVEN)
  notes          String?
  hospital       Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  order          IPDMedicationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([hospitalId])
}

model IPDBedTransfer {
  id            String       @id @default(uuid())
  hospitalId    String
  admissionId   String
  fromBedId     String?
  toBedId       String?
  fromWardId    String?
  toWardId      String?
  reason        String?      @db.Text
  transferredBy String?
  transferredAt DateTime     @default(now())
  admission     IPDAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  hospital      Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([hospitalId])
}

model IPDDischargeSummary {
  id                   String       @id @default(uuid())
  hospitalId           String
  admissionId          String       @unique
  finalDiagnosis       String?      @db.Text
  conditionAtDischarge String?
  dischargeMedications String?      @db.LongText
  followUpInstructions String?      @db.Text
  dietaryInstructions  String?      @db.Text
  billingCleared       Boolean      @default(false)
  dischargedBy         String?
  dischargedAt         DateTime     @default(now())
  admission            IPDAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  hospital             Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
}

