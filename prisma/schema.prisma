model AppointmentDelayAlert {
  id                String   @id @default(uuid())
  hospitalId        String
  appointmentId     String
  patientId         String
  createdByUserId   String?
  type              String   @default("QUEUE_DELAY")
  message           String   @db.Text
  reason            String?  @db.Text
  revisedWaitMin    Int?
  delayMinutes      Int?
  isActive          Boolean  @default(true)
  resolvedAt        DateTime?
  resolvedByUserId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  hospital          Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient           Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdByUser     User?       @relation("AppointmentDelayAlertCreatedBy", fields: [createdByUserId], references: [id])
  resolvedByUser    User?       @relation("AppointmentDelayAlertResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([hospitalId])
  @@index([appointmentId])
  @@index([patientId])
  @@index([hospitalId, isActive])
}

model PaymentTransaction {
  id                    String            @id @default(uuid())
  hospitalId            String
  appointmentId         String?
  billId                String?
  doctorId              String?
  appointmentDate       DateTime?         @db.Date
  timeSlot              String?
  customerId            String?
  idempotencyKey        String?           @unique
  cashfreeOrderId       String            @unique
  cfOrderId             String?
  paymentSessionId      String?           @db.Text
  cashfreePaymentId     String?
  grossAmountPaise      Int
  baseAmountPaise       Int?
  convenienceFeePaise   Int?
  currency              String            @default("INR") @db.VarChar(3)
  bookingFingerprint    String?           @db.Char(64)
  bookingData            Json?
  commissionType        String            @default("PERCENTAGE")
  commissionValue       Int               @default(200)
  commissionRateBps     Int               @default(200)
  commissionAmountPaise Int
  vendorAmountPaise     Int
  status                String            @default("PENDING")
  settlementStatus      String            @default("PENDING")
  paidAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  hospital              Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment           Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  bill                  Bill?             @relation(fields: [billId], references: [id], onDelete: SetNull)
  doctor                Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([appointmentId])
  @@index([billId])
  @@index([doctorId])
  @@index([status])
  @@index([settlementStatus])
}

model CashfreeWebhookEvent {
  id          String   @id @default(uuid())
