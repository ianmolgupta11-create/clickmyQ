generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Hospital {
  id                    String                        @id @default(uuid())
  name                  String
  email                 String                        @unique
  mobile                String
  isVerified            Boolean                       @default(false)
  createdAt             DateTime                      @default(now())
  billingCycle          BillingCycle?
  subscriptionEndDate   DateTime?
  subscriptionPlan      SubscriptionPlan?
  subscriptionStartDate DateTime?
  subscriptionStatus    SubscriptionStatus            @default(TRIAL)
  trialEndDate          DateTime?
  trialStartDate        DateTime?
  chosenPlan            String?
  appointments          Appointment[]
  beds                  Bed[]
  bedAllocations        BedAllocation[]
  bills                 Bill[]
  billItems             BillItem[]
  blogs                 Blog[]
  departments           Department[]
  doctors               Doctor[]
  doctorActions         DoctorAction[]
  enquiries             Enquiry[]
  expenses              Expense[]
  financeDepartment     FinanceDepartment?
  followUps             FollowUp[]
  medicineLibrary       HospitalMedicine[]
  settings              HospitalSettings?
  ipdAdmissions         IPDAdmission[]
  ipdBedTransfers       IPDBedTransfer[]
  ipdClinicalNotes      IPDClinicalNote[]
  ipdDischargeSummaries IPDDischargeSummary[]
  ipdMedicationAdmins   IPDMedicationAdministration[]
  ipdMedicationOrders   IPDMedicationOrder[]
  ipdVitals             IPDVitals[]
  inventoryItems        InventoryItem[]
  labOrders             LabOrder[]
  labPanels             LabPanel[]
  labReports            LabReport[]
  labSamples            LabSample[]
  labTests              LabTest[]
  notifications         Notification[]
  patients              Patient[]
  payments              Payment[]
  paymentTransactions   PaymentTransaction[]
  prescriptions         Prescription[]
  prescriptionWorkflows PrescriptionWorkflow[]
  pricing               Pricing[]
  procedures            Procedure[]
  procedureRecords      ProcedureRecord[]
  purchases             Purchase[]
  purchaseItems         PurchaseItem[]
  revenues              Revenue[]
  rooms                 Room[]
  services              Service[]
  serviceItems          ServiceItem[]
  staffMembers          Staff[]
  stockBatches          StockBatch[]
  stockLocations        StockLocation[]
  stockMovements        StockMovement[]
  stockReturns          StockReturn[]
  stockTransfers        StockTransfer[]
  stockTransferItems    StockTransferItem[]
  subDepartments        SubDepartment[]
  subscriptionPayments  SubscriptionPayment[]
  suppliers             Supplier[]
  treatmentPlans        TreatmentPlan[]
  treatmentSessions     TreatmentSession[]
  users                 User[]
  visits                Visit[]
  wards                 Ward[]
  workflowTasks         WorkflowTask[]
  appointmentDelayAlerts AppointmentDelayAlert[]
}

model User {
  id                String             @id @default(uuid())
  hospitalId        String
  name              String
  email             String             @unique
  password          String
  role              Role
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  profilePhoto      String?            @db.Text
  userCode          String?
  departmentsHOD    Department[]       @relation("DepartmentHOD_User")
  doctor            Doctor?
  financeDepartment FinanceDepartment?
  sessions          Session[]
  staff             Staff?
  subDepartment     SubDepartment?
  hospital          Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  UserPermission    UserPermission[]
  createdDelayAlerts AppointmentDelayAlert[] @relation("AppointmentDelayAlertCreatedBy")
  resolvedDelayAlerts AppointmentDelayAlert[] @relation("AppointmentDelayAlertResolvedBy")

  @@index([hospitalId])
  @@index([email, hospitalId])
}

model OTP {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  mobile    String?

  @@index([mobile])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HospitalSettings {
  id                String   @id @default(uuid())
  hospitalId        String   @unique
  hospitalName      String
  logo              String?
  coverImage        String?  @db.Text
  description       String?  @db.Text
  address           String?  @db.Text
  phone             String?
  email             String?
  website           String?
  timezone          String   @default("Asia/Kolkata")
  currency          String   @default("INR")
  gstNumber         String?
  registrationNo    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  letterhead        String?  @db.Text
  letterheadSize    String?  @default("A4")
  letterheadType    String?  @default("IMAGE")
  bookingSlug       String?  @unique
  facilities        Json?
  specialities      Json?
  razorpayKeyId     String?
  razorpayKeySecret String?
  hospital          Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

model Department {
  id                String          @id @default(uuid())
  hospitalId        String
  name              String
  code              String
  description       String?
  type              DepartmentType  @default(OPD)
  isActive          Boolean         @default(true)
  consultationFee   Float?
  allowAppointments Boolean         @default(true)
  isIPD             Boolean         @default(false)
  hodDoctorId       String?
  location          String?
  billingCode       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  customTypeName    String?
  hodUserId         String?
  credentialsSent   Boolean         @default(false)
  loginEmail        String?         @unique
  appointments      Appointment[]
  bedAllocations    BedAllocation[]
  hodDoctor         Doctor?         @relation("DepartmentHOD", fields: [hodDoctorId], references: [id])
  hodUser           User?           @relation("DepartmentHOD_User", fields: [hodUserId], references: [id])
  hospital          Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors           Doctor[]        @relation("DepartmentDoctors")
  pricing           Pricing[]
  Service           Service[]
  staff             Staff[]
  stockLocations    StockLocation[]
  subDepartments    SubDepartment[]
  TreatmentPlan     TreatmentPlan[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([hodDoctorId], map: "Department_hodDoctorId_fkey")
  @@index([hodUserId], map: "Department_hodUserId_fkey")
}

model SubDepartment {
  id                    String                 @id @default(uuid())
  hospitalId            String
  name                  String
  type                  SubDepartmentType
  departmentId          String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  code                  String?
  color                 String?                @default("#3b82f6")
  credentialsSent       Boolean                @default(false)
  description           String?                @db.Text
  flow                  String?                @db.Text
  hodEmail              String?
  hodName               String?
  hodPhone              String?
  hodStaffId            String?
  loginEmail            String?                @unique
  userId                String?                @unique
  requiresPharmacy      Boolean                @default(false)
  requiresLab           Boolean                @default(false)
  displayOrder          Int                    @default(0)
  icon                  String?
  workflowSteps         String?                @db.Text
  accessFeatures        String?                @db.Text
  customName            String?
  loginPasswordPlain    String?
  appointments          Appointment[]
  labOrders             LabOrder[]
  labPanels             LabPanel[]
  labTests              LabTest[]
  prescriptionWorkflows PrescriptionWorkflow[]
  procedures            Procedure[]
  procedureRecords      ProcedureRecord[]
  purchases             Purchase[]
  services              Service[]
  stockLocations        StockLocation[]
  department            Department?            @relation(fields: [departmentId], references: [id])
  hospital              Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user                  User?                  @relation(fields: [userId], references: [id])
  treatmentPlans        TreatmentPlan[]

  @@unique([hospitalId, name, type])
  @@index([hospitalId])
  @@index([departmentId], map: "SubDepartment_departmentId_fkey")
  @@index([hospitalId, displayOrder])
}

model Procedure {
  id                      String            @id @default(uuid())
  hospitalId              String
  subDepartmentId         String
  name                    String
  description             String?           @db.Text
  type                    ProcedureType     @default(OTHER)
  fee                     Float?
  duration                Int?
  sequence                Int               @default(0)
  isActive                Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  requiresPharmacy        Boolean           @default(false)
  requiresLab             Boolean           @default(false)
  requiresConsent         Boolean           @default(false)
  consentFormUrl          String?
  estimatedDuration       Int?
  preparationInstructions String?           @db.Text
  aftercareInstructions   String?           @db.Text
  contraindications       String?           @db.Text
  displayOrder            Int               @default(0)
  hospital                Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  subDepartment           SubDepartment     @relation(fields: [subDepartmentId], references: [id], onDelete: Cascade)
  procedureRecords        ProcedureRecord[]
  treatmentPlans          TreatmentPlan[]

  @@index([hospitalId])
  @@index([subDepartmentId])
  @@index([hospitalId, subDepartmentId])
  @@index([hospitalId, subDepartmentId, displayOrder])
}

enum DoctorStatus {
  ACTIVE
  EMERGENCY
  ON_BREAK
}

model Doctor {
  id                   String                   @id @default(uuid())
  hospitalId           String
  name                 String
  email                String
  phone                String?
  specialization       String?
  qualification        String?
  departmentId         String?
  consultationFee      Float                    @default(0)
  onlineBookingFee     Float                    @default(0)
  isAvailable          Boolean                  @default(true)
  status               DoctorStatus           @default(ACTIVE)
  statusStartedAt      DateTime?
  expectedReturnAt     DateTime?
  actualReturnAt       DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime               @updatedAt
  experience           Int                      @default(0)
  followUpFee          Float?
  gender               Gender?
  isActive             Boolean                  @default(true)
  profileImage         String?                  @db.Text
  address              String?                  @db.Text
  agreementDoc         String?
  bloodGroup           String?
  credentialsSent      Boolean                  @default(false)
  dateOfBirth          DateTime?
  govtIdCard           String?
  hospitalStamp        String?
  licenseNo            String?
  registrationNo       String?
  signature            String?
  userId               String?                  @unique
  prescriptionSettings String?                  @db.Text
  doctorCode           String?
  emergencyFee         Float?                   @default(0)
  appointments         Appointment[]
  paymentTransactions PaymentTransaction[]
  hodOfDepartments     Department[]             @relation("DepartmentHOD")
  department           Department?              @relation("DepartmentDoctors", fields: [departmentId], references: [id])
  hospital             Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user                 User?                    @relation(fields: [userId], references: [id])
  attendance           DoctorAttendance[]
  availability         DoctorAvailability[]
  dateOverrides        DoctorDateOverride[]
  leaves               DoctorLeave[]
  scheduleTemplates    DoctorScheduleTemplate[]
  medicineLibraryItems HospitalMedicine[]       @relation("DoctorMedicineLibrary")
  labOrders            LabOrder[]
  prescriptions        Prescription[]
  treatmentPlans       TreatmentPlan[]
  visits               Visit[]

  @@unique([hospitalId, email])
  @@index([hospitalId])
  @@index([hospitalId, departmentId])
  @@index([departmentId], map: "Doctor_departmentId_fkey")
}

model DoctorAvailability {
  id                 String    @id @default(uuid())
  doctorId           String
  day                DayOfWeek
  startTime          String
  endTime            String
  createdAt          DateTime  @default(now())
  hospitalId         String
  isActive           Boolean   @default(true)
  slotDuration       Int       @default(30)
  updatedAt          DateTime  @updatedAt
  breaks             String?   @db.Text
  bufferTime         Int       @default(0)
  generatedSlots     String?   @db.Text
  maxPatientsPerSlot Int       @default(1)
  doctor             Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, day])
  @@index([doctorId])
  @@index([hospitalId])
}

model DoctorDateOverride {
  id                 String   @id @default(uuid())
  doctorId           String
  hospitalId         String
  date               DateTime @db.Date
  isOff              Boolean  @default(false)
  startTime          String?
  endTime            String?
  slotDuration       Int?
  bufferTime         Int?
  maxPatientsPerSlot Int?
  breaks             String?  @db.Text
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  doctor             Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
  @@index([hospitalId])
  @@index([doctorId, date])
}

model DoctorScheduleTemplate {
  id           String   @id @default(uuid())
  hospitalId   String
  doctorId     String?
  name         String
  description  String?
  scheduleData String   @db.Text
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  doctor       Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([doctorId])
}

model DoctorLeave {
  id         String   @id @default(uuid())
  doctorId   String
  hospitalId String
  leaveFrom  DateTime
  leaveTo    DateTime
  reason     String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([hospitalId])
  @@index([doctorId, leaveFrom, leaveTo])
}

model DoctorAttendance {
  id             String           @id @default(uuid())
  doctorId       String
  hospitalId     String
  date           DateTime         @db.Date
  status         AttendanceStatus @default(ABSENT)
  loginTime      DateTime?
  logoutTime     DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  loginIp        String?
  loginLocation  String?          @db.Text
  logoutIp       String?
  logoutLocation String?          @db.Text
  totalWorkHours Float?           @default(0)
  doctor         Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([date])
}

model Staff {
  id                 String      @id @default(uuid())
  hospitalId         String
  name               String
  email              String
  phone              String?
  role               StaffRole
  departmentId       String?
  salary             Float       @default(0)
  joinDate           DateTime    @default(now())
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  credentialsSent    Boolean     @default(false)
  mustChangePassword Boolean     @default(true)
  password           String?
  permissions        String?     @db.Text
  userId             String?     @unique
  address            String?     @db.Text
  bankAccountNo      String?
  bankName           String?
  dateOfBirth        DateTime?
  panNo              String?
  pfAccountNo        String?
  pfUan              String?
  department         Department? @relation(fields: [departmentId], references: [id])
  hospital           Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user               User?       @relation(fields: [userId], references: [id])

  @@unique([hospitalId, email])
  @@index([hospitalId])
  @@index([email])
  @@index([departmentId], map: "Staff_departmentId_fkey")
}

model Ward {
  id          String   @id @default(uuid())
  hospitalId  String
  name        String
  type        WardType
  floor       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?  @db.Text
  beds        Bed[]
  rooms       Room[]
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model Room {
  id          String   @id @default(uuid())
  hospitalId  String
  wardId      String
  roomNumber  String
  roomType    RoomType @default(SHARED)
  capacity    Int      @default(1)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  beds        Bed[]
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  ward        Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, roomNumber])
  @@index([hospitalId])
  @@index([wardId])
}

model Bed {
  id          String          @id @default(uuid())
  hospitalId  String
  wardId      String
  bedNumber   String
  status      BedStatus       @default(AVAILABLE)
  pricePerDay Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  bedType     BedType         @default(NORMAL)
  roomId      String?
  hospital    Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  room        Room?           @relation(fields: [roomId], references: [id])
  ward        Ward            @relation(fields: [wardId], references: [id], onDelete: Cascade)
  allocations BedAllocation[]

  @@unique([roomId, bedNumber])
  @@index([hospitalId])
  @@index([wardId])
  @@index([roomId])
  @@index([status])
}

model BedAllocation {
  id                    String           @id @default(uuid())
  hospitalId            String
  bedId                 String
  patientId             String?
  departmentId          String?
  entryType             String?          @default("PATIENT")
  patientName           String
  patientAge            Int?
  patientGender         String?
  patientPhone          String?
  attendantName         String?
  attendantPhone        String?
  diagnosis             String?          @db.Text
  admittingDoctorName   String?
  admissionDate         DateTime         @default(now())
  expectedDischargeDate DateTime?
  actualDischargeDate   DateTime?
  notes                 String?          @db.Text
  status                AllocationStatus @default(ACTIVE)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  bed                   Bed              @relation(fields: [bedId], references: [id], onDelete: Cascade)
  department            Department?      @relation(fields: [departmentId], references: [id])
  hospital              Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  ipdAdmission          IPDAdmission?

  @@index([hospitalId])
  @@index([bedId])
  @@index([status])
  @@index([hospitalId, status])
  @@index([departmentId])
}

model Pricing {
  id           String      @id @default(uuid())
  hospitalId   String
  name         String
  type         PricingType
  amount       Float
  description  String?
  departmentId String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id])
  hospital     Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([hospitalId, type])
  @@index([departmentId], map: "Pricing_departmentId_fkey")
}

model InventoryItem {
  id                String              @id @default(uuid())
  hospitalId        String
  name              String
  category          String
  description       String?             @db.Text
  minStock          Int                 @default(5)
  unit              String              @default("pcs")
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  maxStock          Int?
  sku               String?
  subCategory       String?
  attachments       String?             @db.Text
  barcode           String?
  billingType       String?
  brandName         String?
  conversion        String?
  discount          Float               @default(0)
  drugSchedule      String?
  genericName       String?
  gst               Float               @default(0)
  hsnCode           String?
  image             String?
  isCritical        Boolean             @default(false)
  isReturnable      Boolean             @default(true)
  itemType          String?
  location          String?
  mrp               Float               @default(0)
  packSize          String?
  preferredVendorId String?
  purchasePrice     Float               @default(0)
  purchaseUnit      String?
  rackNumber        String?
  reorderLevel      Int?
  reorderQty        Int?
  requiresRx        Boolean             @default(false)
  sellingPrice      Float               @default(0)
  tempRequirement   String?
  hospital          Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  purchaseItems     PurchaseItem[]
  batches           StockBatch[]
  movements         StockMovement[]
  stockReturns      StockReturn[]
  transferItems     StockTransferItem[]

  @@unique([hospitalId, name, category])
  @@index([hospitalId])
  @@index([hospitalId, category])
}

model HospitalMedicine {
  id              String   @id @default(uuid())
  hospitalId      String
  name            String
  normalizedName  String
  genericName     String?
  strength        String?
  dosageForm      String?
  defaultRoute    String?
  usageCount      Int      @default(0)
  lastUsedAt      DateTime @default(now())
  isActive        Boolean  @default(true)
  addedByDoctorId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  addedByDoctor   Doctor?  @relation("DoctorMedicineLibrary", fields: [addedByDoctorId], references: [id])
  hospital        Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, normalizedName])
  @@index([hospitalId, isActive])
  @@index([hospitalId, lastUsedAt])
  @@index([addedByDoctorId])
}

model SubscriptionPayment {
  id         String           @id @default(uuid())
  hospitalId String
  amount     Float
  plan       SubscriptionPlan
  cycle      BillingCycle
  paidAt     DateTime         @default(now())
  validFrom  DateTime
  validUntil DateTime
  notes      String?          @db.Text
  recordedBy String?
  createdAt  DateTime         @default(now())
  hospital   Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([hospitalId, paidAt])
}

model Patient {
  id                String            @id @default(uuid())
  hospitalId        String
  patientId         String
  name              String
  email             String?
  phone             String
  gender            String?
  dateOfBirth       DateTime?
  bloodGroup        String?
  address           String?           @db.Text
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  allergies         String?           @db.Text
  documents         String?           @db.Text
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  patientType       String?           @default("NEW")
  profilePhoto      String?
  whatsapp          String?
  age               Int?
  appointments      Appointment[]
  bills             Bill[]
  delayAlerts       AppointmentDelayAlert[]
  followUps         FollowUp[]
  ipdAdmissions     IPDAdmission[]
  labOrders         LabOrder[]
  hospital          Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescriptions     Prescription[]
  procedureRecords  ProcedureRecord[]
  treatmentPlans    TreatmentPlan[]
  visits            Visit[]

  @@unique([hospitalId, patientId])
  @@index([hospitalId])
  @@index([hospitalId, phone])
  @@index([hospitalId, name])
}

model Appointment {
  id                 String             @id @default(uuid())
  hospitalId         String
  patientId          String
  doctorId           String?
  departmentId       String?
  appointmentDate    DateTime           @db.Date
  timeSlot           String?
  type               AppointmentType    @default(OPD)
  status             AppointmentStatus  @default(SCHEDULED)
  consultationFee    Float?
  onlineBookingFee  Float?
  tokenNumber        Int?
  notes              String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  subDepartmentId    String?
  subDeptNote        String?            @db.Text
  billingNote        String?            @db.Text
  billingTransferred Boolean            @default(false)
  checkedInAt        DateTime?
  consultEndAt       DateTime?
  consultStartAt     DateTime?
  bookingSource      String             @default("COUNTER")
  department         Department?        @relation(fields: [departmentId], references: [id])
  doctor             Doctor?            @relation(fields: [doctorId], references: [id])
  hospital           Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  subDepartment      SubDepartment?     @relation(fields: [subDepartmentId], references: [id])
  followUps          FollowUp[]
  labOrders          LabOrder[]
  prescription       Prescription?
  procedureRecords   ProcedureRecord[]
  treatmentSessions  TreatmentSession[]
  delayAlerts        AppointmentDelayAlert[]
  paymentTransactions PaymentTransaction[]

  @@index([hospitalId])
  @@index([patientId])
  @@index([doctorId])
  @@index([hospitalId, appointmentDate])
  @@index([hospitalId, status])
  @@index([doctorId, appointmentDate, timeSlot])
  @@index([subDepartmentId])
  @@index([departmentId], map: "Appointment_departmentId_fkey")
}

model FollowUp {
  id            String         @id @default(uuid())
  hospitalId    String
  patientId     String
  appointmentId String?
  followUpDate  DateTime
  reason        String?        @db.Text
  notes         String?        @db.Text
  status        FollowUpStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

